APP_NAME=Telegram Security Scanner
APP_ENV=production
LOG_LEVEL=INFO

TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
PUBLIC_BASE_URL=https://check-safe.onrender.com
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=YOUR_LONG_RANDOM_WEBHOOK_SECRET

DATABASE_URL=YOUR_RENDER_POSTGRES_URL
VIRUSTOTAL_API_KEY=YOUR_VIRUSTOTAL_API_KEY
GOOGLE_SAFE_BROWSING_API_KEY=YOUR_GOOGLE_SAFE_BROWSING_API_KEY

ADMIN_TELEGRAM_IDS=
ALLOW_EXTERNAL_FILE_UPLOAD=false

MAX_FILE_SIZE_MB=50
MAX_ARCHIVE_SIZE_MB=70
MAX_EXTRACTED_FILES=1000
MAX_EXTRACTION_SIZE_MB=100
MAX_ARCHIVE_DEPTH=3

MAX_SCANS_PER_MINUTE=5
MAX_SCANS_PER_HOUR=50
